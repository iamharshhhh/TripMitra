PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=ai-travel-companion

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=your_whatsapp_webhook_verify_token
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_API_VERSION=v21.0
WHATSAPP_APP_SECRET=your_meta_app_secret_optional

# Google Gemini AI Generation
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=30000
AI_MAX_HISTORY_MESSAGES=20

# Google Gemini Embedding & RAG Configuration
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
RAG_NUM_CANDIDATES=100

# External Tools & Multi-Provider AI Fallbacks
GOOGLE_PLACES_API_KEY=your_google_places_api_key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
GROK_API_KEY=your_grok_api_key
WEATHER_PROVIDER=open-meteo
WEATHER_TIMEOUT_MS=10000
